# Server-side only. Never expose these to a frontend or commit the real .env.
OPENAI_API_KEY=sk-...

# Optional: leave unset to use the Agents SDK default model.
# AGENT_MODEL=gpt-5.4

AGENT_NAME=Assistant
MAX_TURNS=10

# JSON array. Set to your frontend origin(s), or [] if there is no browser client.
CORS_ORIGINS=["http://localhost:3000"]

# --- RAG (only if File Search was confirmed) ---
# Created once by `python -m scripts.create_vector_store`. Reused for every upload.
# VECTOR_STORE_ID=vs_...

# --- MCP (only if an MCP was confirmed and verified) ---
# MCP_SERVER_URL=https://...
# MCP_SERVER_TOKEN=...
